{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-cut.local/schemas/offline-deps-manifest.schema.json",
  "title": "Auto-Cut Offline Dependency Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_version",
    "source_commit",
    "target",
    "components",
    "files",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "release_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "python_implementation", "python_version", "abi"],
      "properties": {
        "os": {"const": "windows"},
        "arch": {"const": "x64"},
        "python_implementation": {"const": "cpython"},
        "python_version": {"const": "3.11"},
        "abi": {"const": "cp311"}
      }
    },
    "components": {"type": "object"},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256", "component", "version", "platform", "license", "source"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*[\u0000-\u001F])(?!/)(?!.*\\\\)(?!.*[<>\"|?*])(?!.*(?:^|/)\\.\\.?(?:/|$))(?![A-Za-z]:)(?!.*:)(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Oo][Mm](?:[1-9]|\\u00b9|\\u00b2|\\u00b3)|[Ll][Pp][Tt](?:[1-9]|\\u00b9|\\u00b2|\\u00b3))(?:\\.[^/]*)?(?:/|$))(?!.*[. ](?:/|$))[^/]+(?:/[^/]+)*$"
          },
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "component": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
